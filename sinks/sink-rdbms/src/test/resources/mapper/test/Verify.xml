<mapper namespace="com.anyilanxin.kunpeng.sink.rdbms.VerificationMapper">

  <select id="totalRows" resultType="long">
    SELECT
      (SELECT COUNT(*) FROM kp_process_definition)
      + (SELECT COUNT(*) FROM kp_process_instance)
      + (SELECT COUNT(*) FROM kp_activity_instance)
      + (SELECT COUNT(*) FROM kp_variable)
      + (SELECT COUNT(*) FROM kp_user_task)
      + (SELECT COUNT(*) FROM kp_job)
      + (SELECT COUNT(*) FROM kp_incident)
      + (SELECT COUNT(*) FROM kp_timer)
      + (SELECT COUNT(*) FROM kp_message_subscription)
      + (SELECT COUNT(*) FROM kp_signal_subscription)
  </select>

  <select id="instanceRow" resultType="map">
    SELECT * FROM kp_process_instance
  </select>

  <select id="variableRows" resultType="map">
    SELECT scope_id, name, CAST(value_json AS VARCHAR) AS value_json FROM kp_variable ORDER BY name
  </select>

  <select id="userTaskRow" resultType="map">
    SELECT * FROM kp_user_task
  </select>

  <select id="activityInstanceRow" resultType="map">
    SELECT * FROM kp_activity_instance
  </select>

  <select id="sinkPositionRow" resultType="long">
    SELECT exported_position FROM kp_sink_position WHERE partition_id = 1
  </select>

</mapper>
