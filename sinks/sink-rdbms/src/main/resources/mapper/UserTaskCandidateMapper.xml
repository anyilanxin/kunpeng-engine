<mapper namespace="com.anyilanxin.kunpeng.sink.rdbms.mapper.UserTaskCandidateMapper">

  <insert id="insert" parameterType="com.anyilanxin.kunpeng.sink.rdbms.model.UserTaskCandidateDbModel">
    INSERT INTO ${table.user_task_candidate} (
      task_id, process_instance_id, candidate_type, candidate_value, resource_id
    ) VALUES (
      #{taskId}, #{processInstanceId}, #{candidateType}, #{candidateValue}, #{resourceId}
    )
  </insert>

  <delete id="cleanupByTask">
    DELETE FROM ${table.user_task_candidate} WHERE task_id = #{taskId}
  </delete>

  <delete id="cleanupHistory">
    DELETE FROM ${table.user_task_candidate} WHERE process_instance_id = #{processInstanceId}
  </delete>

  <delete id="clearAll">DELETE FROM ${table.user_task_candidate}</delete>

</mapper>
