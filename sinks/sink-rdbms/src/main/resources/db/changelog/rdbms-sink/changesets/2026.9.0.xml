<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- 2026.9.0 基线：10 张业务表 + 索引。标识符统一 ${table.x}（变量值=完整物理名：前缀+大小写策略运行期注入，索引逻辑名须同步登记到 Tables.INDEXES）；列定义必须与 Tables.java 保持一致。 -->

  <changeSet id="2026.9.0-create-process-definition" author="anyilanxin">
    <createTable tableName="${table.process_definition}">
      <column name="process_definition_id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="definition_key" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="definition_name" type="VARCHAR(255)"/>
      <column name="version" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="version_tag" type="VARCHAR(255)"/>
      <column name="history_time_to_live" type="INT"/>
      <column name="deployment_id" type="BIGINT"/>
      <column name="resource_definition_id" type="BIGINT"/>
      <column name="resource_name" type="VARCHAR(255)"/>
      <column name="checksum" type="VARCHAR(128)"/>
      <column name="starter_events" type="${text.type}"/>
      <column name="candidate_starter_groups" type="${text.type}"/>
      <column name="candidate_starter_users" type="${text.type}"/>
      <column name="resource_content" type="${large.type}"/>
      <column name="resource_id" type="INT"/>
    </createTable>
    <createIndex tableName="${table.process_definition}" indexName="${table.idx_pd_key}">
      <column name="definition_key"/>
      <column name="version"/>
    </createIndex>
  </changeSet>

  <changeSet id="2026.9.0-create-process-instance" author="anyilanxin">
    <createTable tableName="${table.process_instance}">
      <column name="process_instance_id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="parent_process_instance_id" type="BIGINT"/>
      <column name="root_process_instance_id" type="BIGINT"/>
      <column name="business_key" type="VARCHAR(255)"/>
      <column name="process_definition_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="definition_key" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="definition_name" type="VARCHAR(255)"/>
      <column name="start_user" type="VARCHAR(255)"/>
      <column name="state" type="VARCHAR(32)">
        <constraints nullable="false"/>
      </column>
      <column name="start_time" type="${ts.type}"/>
      <column name="end_time" type="${ts.type}"/>
      <column name="revision" type="INT"/>
      <column name="resource_id" type="INT"/>
    </createTable>
    <createIndex tableName="${table.process_instance}" indexName="${table.idx_pi_definition}">
      <column name="process_definition_id"/>
    </createIndex>
    <createIndex tableName="${table.process_instance}" indexName="${table.idx_pi_parent}">
      <column name="parent_process_instance_id"/>
    </createIndex>
    <createIndex tableName="${table.process_instance}" indexName="${table.idx_pi_root}">
      <column name="root_process_instance_id"/>
    </createIndex>
  </changeSet>

  <changeSet id="2026.9.0-create-activity-instance" author="anyilanxin">
    <createTable tableName="${table.activity_instance}">
      <column name="activity_instance_id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="process_instance_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="root_process_instance_id" type="BIGINT"/>
      <column name="parent_activity_instance_id" type="BIGINT"/>
      <column name="call_process_instance_id" type="BIGINT"/>
      <column name="process_definition_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="definition_key" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="activity_key" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="activity_name" type="VARCHAR(255)"/>
      <column name="activity_type" type="VARCHAR(64)"/>
      <column name="task_id" type="BIGINT"/>
      <column name="assignee" type="VARCHAR(255)"/>
      <column name="state" type="VARCHAR(32)"/>
      <column name="incident_id" type="BIGINT"/>
      <column name="sequence_counter" type="BIGINT"/>
      <column name="start_time" type="${ts.type}"/>
      <column name="end_time" type="${ts.type}"/>
      <column name="duration" type="BIGINT"/>
      <column name="revision" type="INT"/>
      <column name="resource_id" type="INT"/>
    </createTable>
    <createIndex tableName="${table.activity_instance}" indexName="${table.idx_ai_instance}">
      <column name="process_instance_id"/>
    </createIndex>
    <createIndex tableName="${table.activity_instance}" indexName="${table.idx_ai_task}">
      <column name="task_id"/>
    </createIndex>
  </changeSet>

  <changeSet id="2026.9.0-create-variable" author="anyilanxin">
    <createTable tableName="${table.variable}">
      <column name="scope_id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(255)">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="parent_scope_id" type="BIGINT"/>
      <column name="process_instance_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="process_definition_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="value_json" type="${text.type}"/>
      <column name="revision" type="INT"/>
      <column name="resource_id" type="INT"/>
    </createTable>
    <createIndex tableName="${table.variable}" indexName="${table.idx_var_instance}">
      <column name="process_instance_id"/>
    </createIndex>
  </changeSet>

  <changeSet id="2026.9.0-create-user-task" author="anyilanxin">
    <createTable tableName="${table.user_task}">
      <column name="task_id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="activity_instance_id" type="BIGINT"/>
      <column name="process_instance_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="business_key" type="VARCHAR(255)"/>
      <column name="process_definition_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="definition_key" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="task_definition_key" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="task_name" type="VARCHAR(255)"/>
      <column name="assignee" type="VARCHAR(255)"/>
      <column name="owner" type="VARCHAR(255)"/>
      <column name="priority" type="INT"/>
      <column name="due_time" type="${ts.type}"/>
      <column name="follow_up_time" type="${ts.type}"/>
      <column name="state" type="VARCHAR(32)"/>
      <column name="candidate_groups" type="${text.type}"/>
      <column name="candidate_users" type="${text.type}"/>
      <column name="start_time" type="${ts.type}"/>
      <column name="end_time" type="${ts.type}"/>
      <column name="duration" type="BIGINT"/>
      <column name="revision" type="INT"/>
      <column name="resource_id" type="INT"/>
    </createTable>
    <createIndex tableName="${table.user_task}" indexName="${table.idx_ut_instance}">
      <column name="process_instance_id"/>
    </createIndex>
    <createIndex tableName="${table.user_task}" indexName="${table.idx_ut_assignee}">
      <column name="assignee"/>
    </createIndex>
  </changeSet>

  <changeSet id="2026.9.0-create-job" author="anyilanxin">
    <createTable tableName="${table.job}">
      <column name="job_id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="job_type" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="job_kind" type="VARCHAR(64)"/>
      <column name="state" type="VARCHAR(32)"/>
      <column name="retries" type="INT"/>
      <column name="retry_backoff" type="INT"/>
      <column name="priority" type="INT"/>
      <column name="due_time" type="${ts.type}"/>
      <column name="lock_owner" type="VARCHAR(255)"/>
      <column name="lock_expire_time" type="${ts.type}"/>
      <column name="process_instance_id" type="BIGINT"/>
      <column name="activity_instance_id" type="BIGINT"/>
      <column name="process_definition_id" type="BIGINT"/>
      <column name="definition_key" type="VARCHAR(255)"/>
      <column name="activity_key" type="VARCHAR(255)"/>
      <column name="task_id" type="BIGINT"/>
      <column name="incident_id" type="BIGINT"/>
      <column name="denied_reason" type="VARCHAR(1024)"/>
      <column name="start_time" type="${ts.type}"/>
      <column name="end_time" type="${ts.type}"/>
      <column name="duration" type="BIGINT"/>
      <column name="variables_json" type="${text.type}"/>
      <column name="local_variables_json" type="${text.type}"/>
      <column name="revision" type="INT"/>
      <column name="resource_id" type="INT"/>
    </createTable>
    <createIndex tableName="${table.job}" indexName="${table.idx_job_instance}">
      <column name="process_instance_id"/>
    </createIndex>
    <createIndex tableName="${table.job}" indexName="${table.idx_job_state_due}">
      <column name="state"/>
      <column name="due_time"/>
    </createIndex>
  </changeSet>

  <changeSet id="2026.9.0-create-incident" author="anyilanxin">
    <createTable tableName="${table.incident}">
      <column name="incident_id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="incident_type" type="VARCHAR(64)">
        <constraints nullable="false"/>
      </column>
      <column name="incident_message" type="${text.type}"/>
      <column name="process_instance_id" type="BIGINT"/>
      <column name="activity_instance_id" type="BIGINT"/>
      <column name="process_definition_id" type="BIGINT"/>
      <column name="definition_key" type="VARCHAR(255)"/>
      <column name="activity_key" type="VARCHAR(255)"/>
      <column name="task_id" type="BIGINT"/>
      <column name="job_id" type="BIGINT"/>
      <column name="related_value_type" type="VARCHAR(64)"/>
      <column name="related_lifecycle" type="VARCHAR(64)"/>
      <column name="state" type="VARCHAR(32)">
        <constraints nullable="false"/>
      </column>
      <column name="created_time" type="${ts.type}"/>
      <column name="resolved_time" type="${ts.type}"/>
      <column name="resource_id" type="INT"/>
    </createTable>
    <createIndex tableName="${table.incident}" indexName="${table.idx_inc_instance}">
      <column name="process_instance_id"/>
    </createIndex>
  </changeSet>

  <changeSet id="2026.9.0-create-timer" author="anyilanxin">
    <createTable tableName="${table.timer}">
      <column name="timer_id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="due_time" type="${ts.type}"/>
      <column name="repetitions" type="INT"/>
      <column name="process_instance_id" type="BIGINT"/>
      <column name="activity_instance_id" type="BIGINT"/>
      <column name="process_definition_id" type="BIGINT"/>
      <column name="definition_key" type="VARCHAR(255)"/>
      <column name="activity_key" type="VARCHAR(255)"/>
      <column name="timer_element_type" type="VARCHAR(64)"/>
      <column name="timer_type" type="VARCHAR(64)"/>
      <column name="timer_content" type="VARCHAR(1024)"/>
      <column name="state" type="VARCHAR(32)"/>
      <column name="resource_id" type="INT"/>
    </createTable>
    <createIndex tableName="${table.timer}" indexName="${table.idx_timer_due}">
      <column name="state"/>
      <column name="due_time"/>
    </createIndex>
    <createIndex tableName="${table.timer}" indexName="${table.idx_timer_instance}">
      <column name="process_instance_id"/>
    </createIndex>
  </changeSet>

  <changeSet id="2026.9.0-create-message-subscription" author="anyilanxin">
    <createTable tableName="${table.message_subscription}">
      <column name="message_subscription_id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="message_name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="message_type" type="VARCHAR(64)"/>
      <column name="correlation_key" type="VARCHAR(255)"/>
      <column name="process_instance_id" type="BIGINT"/>
      <column name="activity_instance_id" type="BIGINT"/>
      <column name="correlation_activity_instance_id" type="BIGINT"/>
      <column name="correlation_process_instance_id" type="BIGINT"/>
      <column name="process_definition_id" type="BIGINT"/>
      <column name="definition_key" type="VARCHAR(255)"/>
      <column name="activity_key" type="VARCHAR(255)"/>
      <column name="state" type="VARCHAR(32)"/>
      <column name="resource_id" type="INT"/>
    </createTable>
    <createIndex tableName="${table.message_subscription}" indexName="${table.idx_ms_instance}">
      <column name="process_instance_id"/>
    </createIndex>
    <createIndex tableName="${table.message_subscription}" indexName="${table.idx_ms_name}">
      <column name="message_name"/>
      <column name="correlation_key"/>
    </createIndex>
  </changeSet>

  <changeSet id="2026.9.0-create-signal-subscription" author="anyilanxin">
    <createTable tableName="${table.signal_subscription}">
      <column name="signal_subscription_id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="signal_name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="signal_type" type="VARCHAR(64)"/>
      <column name="process_instance_id" type="BIGINT"/>
      <column name="activity_instance_id" type="BIGINT"/>
      <column name="process_definition_id" type="BIGINT"/>
      <column name="definition_key" type="VARCHAR(255)"/>
      <column name="activity_key" type="VARCHAR(255)"/>
      <column name="state" type="VARCHAR(32)"/>
      <column name="resource_id" type="INT"/>
    </createTable>
    <createIndex tableName="${table.signal_subscription}" indexName="${table.idx_ss_name}">
      <column name="signal_name"/>
    </createIndex>
    <createIndex tableName="${table.signal_subscription}" indexName="${table.idx_ss_instance}">
      <column name="process_instance_id"/>
    </createIndex>
  </changeSet>

  <!-- 补齐活动实例的起点信息（流程实例迁移/改单场景的起始来源）；独立 changeset 保证已建库不因基线改动校验和失配 -->
  <changeSet id="2026.9.0-add-activity-start-columns" author="anyilanxin">
    <addColumn tableName="${table.activity_instance}">
      <column name="start_activity_definition_key" type="VARCHAR(255)"/>
      <column name="start_activity_instance_id" type="BIGINT"/>
    </addColumn>
  </changeSet>

  <!-- sink 自身的导出位置：与数据同事务提交，是业务端权威续传锚点（引擎侧位置只作压缩门槛与投递游标） -->
  <changeSet id="2026.9.0-create-sink-position" author="anyilanxin">
    <createTable tableName="${table.sink_position}">
      <column name="partition_id" type="INT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="sink" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="exported_position" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="created_time" type="${ts.type}"/>
      <column name="update_time" type="${ts.type}"/>
    </createTable>
  </changeSet>

  <!-- 列名对齐协议 Record key（DEFINITION_KEY→PROCESS_DEFINITION_KEY、ACTIVITY_KEY→ACTIVITY_DEFINITION_KEY、DUE_TIME→DUE_DATE、FOLLOW_UP_TIME→FOLLOW_UP_DATE、TASK_NAME→TASK_DEFINITION_NAME、START_USER→START_USER_ID）。
       基线 createTable 已在存量库执行、不可改（校验和失配），新建库走先建后改名，存量库由本变更集原位改名保数据 -->
  <changeSet id="2026.9.0-rename-columns-to-protocol-keys" author="anyilanxin">
    <renameColumn tableName="${table.process_definition}" oldColumnName="definition_key" newColumnName="process_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.process_definition}" oldColumnName="definition_name" newColumnName="process_definition_name" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.process_instance}" oldColumnName="definition_key" newColumnName="process_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.process_instance}" oldColumnName="definition_name" newColumnName="process_definition_name" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.process_instance}" oldColumnName="start_user" newColumnName="start_user_id" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.activity_instance}" oldColumnName="definition_key" newColumnName="process_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.activity_instance}" oldColumnName="activity_key" newColumnName="activity_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.activity_instance}" oldColumnName="activity_name" newColumnName="activity_definition_name" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.activity_instance}" oldColumnName="activity_type" newColumnName="activity_definition_type" columnDataType="VARCHAR(64)"/>
    <renameColumn tableName="${table.user_task}" oldColumnName="definition_key" newColumnName="process_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.user_task}" oldColumnName="task_name" newColumnName="task_definition_name" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.user_task}" oldColumnName="due_time" newColumnName="due_date" columnDataType="${ts.type}"/>
    <renameColumn tableName="${table.user_task}" oldColumnName="follow_up_time" newColumnName="follow_up_date" columnDataType="${ts.type}"/>
    <renameColumn tableName="${table.job}" oldColumnName="definition_key" newColumnName="process_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.job}" oldColumnName="activity_key" newColumnName="activity_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.job}" oldColumnName="due_time" newColumnName="due_date" columnDataType="${ts.type}"/>
    <renameColumn tableName="${table.incident}" oldColumnName="definition_key" newColumnName="process_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.incident}" oldColumnName="activity_key" newColumnName="activity_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.timer}" oldColumnName="due_time" newColumnName="due_date" columnDataType="${ts.type}"/>
    <renameColumn tableName="${table.timer}" oldColumnName="definition_key" newColumnName="process_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.timer}" oldColumnName="activity_key" newColumnName="activity_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.message_subscription}" oldColumnName="definition_key" newColumnName="process_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.message_subscription}" oldColumnName="activity_key" newColumnName="activity_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.signal_subscription}" oldColumnName="definition_key" newColumnName="process_definition_key" columnDataType="VARCHAR(255)"/>
    <renameColumn tableName="${table.signal_subscription}" oldColumnName="activity_key" newColumnName="activity_definition_key" columnDataType="VARCHAR(255)"/>
  </changeSet>

</databaseChangeLog>
