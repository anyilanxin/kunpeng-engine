<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- 加签：任务行是否允许再加签（引擎创建时按建模固化：原任务=声明允许；加签任务=开启 cascade 且深度+1≤maxDepth），导出面据此展示/隐藏加签入口；存量行回填 false（旧任务一律不展示入口）；追加式 -->
  <changeSet id="2026.11.0-add-sign-allowed" author="anyilanxin">
    <addColumn tableName="${table.user_task}">
      <column name="add_sign_allowed" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

</databaseChangeLog>
