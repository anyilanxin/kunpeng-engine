<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    跨方言列类型变量：时间列在 MySQL/MariaDB 上用 DATETIME(3)（规避 TIMESTAMP 的 2038 上限），
    大文本列按各方言的可用类型。后续加字段/加表请按版本号追加 changesets/<版本>.xml 并在此 include。
  -->
  <property name="ts.type" value="DATETIME(3)" dbms="mysql,mariadb"/>
  <property name="ts.type" value="TIMESTAMP(3)" dbms="postgresql,h2"/>
  <property name="text.type" value="CLOB" dbms="h2"/>
  <property name="text.type" value="TEXT" dbms="postgresql,mysql,mariadb"/>
  <property name="large.type" value="LONGTEXT" dbms="mysql,mariadb"/>
  <property name="large.type" value="TEXT" dbms="postgresql"/>
  <property name="large.type" value="CLOB" dbms="h2"/>

  <include file="changesets/2026.9.0.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
