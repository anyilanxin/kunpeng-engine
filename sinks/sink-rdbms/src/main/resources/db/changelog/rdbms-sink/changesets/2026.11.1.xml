<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- 2026.11.1:新增任务候选链接表(一行一个候选,USER/GROUP 拆行;assignee 优先、候选次之的按人可见性查询用,
       JSON 数组列无法走索引且子串误伤);列定义与 Tables.java 保持一致 -->

  <changeSet id="2026.11.1-create-user-task-candidate" author="anyilanxin">
    <createTable tableName="${table.user_task_candidate}" remarks="任务候选链接(一行一个候选)">
      <column name="task_id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="process_instance_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="candidate_type" type="VARCHAR(16)">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="candidate_value" type="VARCHAR(255)">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="resource_id" type="INT"/>
    </createTable>
    <!-- 反查索引:按人/组找任务(可见性 EXISTS 匹配) -->
    <createIndex tableName="${table.user_task_candidate}" indexName="${table.idx_uct_value}">
      <column name="candidate_type"/>
      <column name="candidate_value"/>
    </createIndex>
    <!-- 实例历史清理直删 -->
    <createIndex tableName="${table.user_task_candidate}" indexName="${table.idx_uct_instance}">
      <column name="process_instance_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
