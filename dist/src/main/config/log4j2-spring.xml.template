<?xml version="1.0" encoding="UTF-8"?>
<!--
  kunpeng 日志配置模板（log4j2）

  使用：
    1. 复制为 jar 同级 config/log4j2-spring.xml
    2. 在外部 config/application.yml 中覆盖 logging.config: config/log4j2-spring.xml
       （jar 内默认指向 classpath:log4j2-spring.xml，不覆盖则外置文件不生效）

  可调参数（系统属性 -D 或环境变量覆盖）：
    - logging.file.path  日志目录，默认 logs
    - logging.file.name  日志文件名前缀，默认 kunpeng；启动器按形态自动注入 kunpeng-broker / kunpeng-gateway
-->
<configuration status="WARN">
  <Properties>
    <property name="FILE_PATH" value="${sys:logging.file.path:-logs}"/>
    <property name="FILE_NAME" value="${sys:logging.file.name:-kunpeng}"/>
    <property name="LOG_PATTERN"
              value="%date{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{500} - %msg%n"/>
  </Properties>

  <appenders>

    <!-- 控制台输出（容器/开发环境） -->
    <console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="${LOG_PATTERN}"/>
    </console>

    <!-- 全量日志：单文件 30MB 滚动，最多保留 15 个压缩包，超期 60 天自动清理 -->
    <RollingFile name="RollingFile" fileName="${FILE_PATH}/${FILE_NAME}-all.log"
                 filePattern="${FILE_PATH}/${FILE_NAME}-all-%d{yyyy-MM-dd}_%i.log.gz">
      <PatternLayout pattern="${LOG_PATTERN}"/>
      <Policies>
        <SizeBasedTriggeringPolicy size="30MB"/>
      </Policies>
      <DefaultRolloverStrategy max="15">
        <Delete basePath="${FILE_PATH}" maxDepth="1">
          <IfFileName glob="${FILE_NAME}-all-*.log.gz"/>
          <IfLastModified age="60d"/>
        </Delete>
      </DefaultRolloverStrategy>
    </RollingFile>

    <!-- 错误日志：仅 error 及以上，按天 + 30MB 滚动，最多保留 15 个压缩包，超期 60 天自动清理 -->
    <RollingFile name="RollingFileError" fileName="${FILE_PATH}/${FILE_NAME}-error.log"
                 filePattern="${FILE_PATH}/${FILE_NAME}-error-%d{yyyy-MM-dd}_%i.log.gz">
      <ThresholdFilter level="error" onMatch="ACCEPT" onMismatch="DENY"/>
      <PatternLayout pattern="${LOG_PATTERN}"/>
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
        <SizeBasedTriggeringPolicy size="30MB"/>
      </Policies>
      <DefaultRolloverStrategy max="15">
        <Delete basePath="${FILE_PATH}" maxDepth="1">
          <IfFileName glob="${FILE_NAME}-error-*.log.gz"/>
          <IfLastModified age="60d"/>
        </Delete>
      </DefaultRolloverStrategy>
    </RollingFile>

  </appenders>
  <loggers>
    <!-- 框架与容器日志收敛到 info，避免刷屏 -->
    <logger name="org.springframework" level="info"/>
    <logger name="reactor.netty.http.server" level="info"/>
    <!-- 集群通信明细（成员发现/消息收发），排查集群问题再放开 debug -->
    <logger name="com.anyilanxin.kunpeng.cluster" level="debug"/>
    <!-- 分区消息服务高频日志固定 info，避免覆盖 root 级别时刷屏 -->
    <logger name="com.anyilanxin.kunpeng.cluster.config.messaging.PartitionMessagingService" level="info"/>
    <logger name="com.anyilanxin.kunpeng.cluster.cluster.protocol.swim" level="info"/>

    <!-- 生产环境建议 root 调整为 info；debug 仅用于问题排查 -->
    <root level="debug">
      <appender-ref ref="Console"/>
      <appender-ref ref="RollingFile"/>
      <appender-ref ref="RollingFileError"/>
    </root>
  </loggers>

</configuration>
