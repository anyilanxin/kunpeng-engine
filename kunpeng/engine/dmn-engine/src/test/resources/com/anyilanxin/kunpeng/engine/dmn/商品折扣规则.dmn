      </dmndi:DMNShape>
      <dmndi:DMNEdge id="DMNEdge_1v7g53z" dmnElementRef="KnowledgeRequirement_1ttooj7">
        <di:waypoint x="250" y="297" />
        <di:waypoint x="242" y="180" />
      </dmndi:DMNEdge>
      <dmndi:DMNShape id="DMNShape_1jhlrdu" dmnElementRef="BusinessKnowledgeModel_1ll8p0q">
