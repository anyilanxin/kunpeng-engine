    <knowledgeRequirement id="KnowledgeRequirement_1ttooj7">
      <requiredKnowledge href="#busi_3" />
    </knowledgeRequirement>
    <decisionTable id="DecisionTable_0e5lwo0" hitPolicy="FIRST">
      <input id="Input_1" biodi:width="192">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text>productName</text>
        </inputExpression>
      </input>
      <input id="InputClause_14zuctk">
        <inputExpression id="LiteralExpression_1srakbv" typeRef="number">
          <text>productPrice</text>
        </inputExpression>
      </input>
      <output id="Output_1" name="productDiscoount" typeRef="number" />
      <output id="OutputClause_1ask9qt" name="productDiscoountPrice" typeRef="number" />
      <rule id="DecisionRule_1lo4pr9">
        <description>8折</description>
        <inputEntry id="UnaryTests_0i3mgvz">
          <text>not("sdfsf","sdfsdf")</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1bu7n96">
          <text>&gt;2000</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_108lvk6">
          <text>0.8</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1nt9tv7">
          <text>productPrice*0.8</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_18jp8fj">
        <description>75折</description>
        <inputEntry id="UnaryTests_1lzqpwg">
          <text>"全单吉他"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_07gxafc">
          <text>&gt;5000*10</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1bisgtu">
          <text>0.75</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0cun2e0">
          <text>productPrice*0.75</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0wtl7yp">
        <description>9折</description>
        <inputEntry id="UnaryTests_02qbep1">
          <text>"碳纤维吉他"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1cjabas">
          <text>&gt;6000*10</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1f02szq">
          <text>0.9</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1834csc">
          <text>productPrice*0.9</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_17h3af2">
        <description>原价</description>
        <inputEntry id="UnaryTests_1c1s5im">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_1dm51lw">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0j0dnk5">
          <text>1</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_10n59m8">
          <text>productPrice</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
