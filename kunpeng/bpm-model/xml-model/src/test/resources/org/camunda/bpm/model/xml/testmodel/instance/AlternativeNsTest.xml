<animals xmlns="http://camunda.org/animals"
  xmlns:tns="http://camunda.org/animals"
  xmlns:mechanical="http://camunda.org/mechanical"
  xmlns:yans="http://camunda.org/yans"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://camunda.org/animals ../Testmodel.xsd ">

  <bird id="hedwig" gender="Male">
    <mechanical:wings>wusch</mechanical:wings>
  </bird>
  <bird id="birdo" gender="Female">
   <mechanical:wings>zisch</mechanical:wings>
  </bird>
  <bird id="donald" gender="Unknown" yans:canHazExtendedWings="true">
   <yans:wings>flappy</yans:wings>
  </bird>
  <bird id="plucky" gender="Unknown" mechanical:canHazExtendedWings="false"/>
</animals>
