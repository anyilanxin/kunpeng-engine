                  </kunpeng:entry>
                  <kunpeng:entry key="map">
                    <kunpeng:map>
                      <kunpeng:entry key="so">nested</kunpeng:entry>
                    </kunpeng:map>
                  </kunpeng:entry>
                </kunpeng:map>
              </kunpeng:value>
            </kunpeng:list>
          </kunpeng:outputParameter>
        </kunpeng:inputOutput>
      </extensionElements>
