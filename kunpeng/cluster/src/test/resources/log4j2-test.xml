<Configuration status="WARN">

  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%X{actor-name}] %-5level %logger{36} - %msg%n"/>
    </Console>
  </Appenders>

  <Loggers>
    <Logger name="com.anyilanxin.kunpeng.cluster" level="debug"/>
    <Logger name="com.anyilanxin.kunpeng.cluster.cluster.messaging" level="info"/>
    <Logger name="com.anyilanxin.kunpeng.cluster.cluster.protocol.SwimMembershipProtocol" level="info"/>
    <Root level="info">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>

</Configuration>
