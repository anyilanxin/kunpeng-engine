        "kind": "CREDENTIAL",
        "name": "REST Authentication",
        "id": "io.camunda.connectors:rest-authentication:1",
        "version": 1,
        "properties": [
            {
                "description": "Choose the authentication type. Select 'None' if no authentication is necessary",
                "binding": {
                    "name": "authentication.type",
                    "type": "property"
                },
                "id": "authentication.type",
                "label": "Type",
                "type": "Dropdown",
                "choices": [
                    {
                        "name": "API key",
                        "value": "apiKey"
                    },
                    {
                        "name": "Basic",
                        "value": "basic"
                    },
                    {
                        "name": "Bearer token",
                        "value": "bearer"
                    },
                    {
                        "name": "None",
                        "value": "noAuth"
                    },
                    {
                        "name": "OAuth 2.0",
                        "value": "oauth-client-credentials-flow"
                    },
                    {
                        "name": "OAuth 2.0 Refresh Token",
                        "value": "oauth-refresh-token"
                    }
                ],
                "value": "noAuth",
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "apiKey",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "tooltip": "Send API key in header or as query parameter.",
                "binding": {
                    "name": "authentication.apiKeyLocation",
                    "type": "property"
                },
                "id": "authentication.apiKeyLocation",
                "label": "Api key location",
                "type": "Dropdown",
                "choices": [
                    {
                        "name": "Headers",
                        "value": "headers"
                    },
                    {
                        "name": "Query parameters",
                        "value": "query"
                    }
                ],
                "value": "headers",
                "constraints": {"notEmpty": true},
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "apiKey",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "binding": {
                    "name": "authentication.name",
                    "type": "property"
                },
                "id": "authentication.name",
                "label": "API key name",
                "type": "String",
                "constraints": {"notEmpty": true},
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "apiKey",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "binding": {
                    "name": "authentication.value",
                    "type": "property"
                },
                "id": "authentication.value",
                "label": "API key value",
                "secret": true,
                "type": "String",
                "constraints": {"notEmpty": true},
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "basic",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "binding": {
                    "name": "authentication.username",
                    "type": "property"
                },
                "id": "authentication.username",
                "label": "Username",
                "type": "String",
                "constraints": {"notEmpty": true},
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "basic",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "binding": {
                    "name": "authentication.password",
                    "type": "property"
                },
                "id": "authentication.password",
                "label": "Password",
                "secret": true,
                "type": "String",
                "constraints": {"notEmpty": true},
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "bearer",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "binding": {
                    "name": "authentication.token",
                    "type": "property"
                },
                "id": "authentication.token",
                "label": "Bearer token",
                "secret": true,
                "type": "String",
                "constraints": {"notEmpty": true},
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "oauth-client-credentials-flow",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "binding": {
                    "name": "authentication.oauthTokenEndpoint",
                    "type": "property"
                },
                "id": "authentication.oauthTokenEndpoint",
                "label": "OAuth 2.0 token endpoint",
                "type": "String",
                "constraints": {
                    "pattern": {
                        "message": "Must be a http(s) URL",
                        "value": "^(=|(http://|https://|secrets|\\{\\{).*$)"
                    },
                    "notEmpty": true
                },
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "oauth-client-credentials-flow",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "tooltip": "Your application's client ID from the OAuth client",
                "binding": {
                    "name": "authentication.clientId",
                    "type": "property"
                },
                "id": "authentication.clientId",
                "label": "Client ID",
                "type": "String",
                "constraints": {"notEmpty": true},
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "oauth-client-credentials-flow",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "tooltip": "Your application's client secret from the OAuth client",
                "binding": {
                    "name": "authentication.clientSecret",
                    "type": "property"
                },
                "id": "authentication.clientSecret",
                "label": "Client secret",
                "secret": true,
                "type": "String",
                "constraints": {"notEmpty": true},
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "oauth-client-credentials-flow",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "tooltip": "The unique identifier of the target API you want to access",
                "binding": {
                    "name": "authentication.audience",
                    "type": "property"
                },
                "id": "authentication.audience",
                "label": "Audience",
                "type": "String",
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "oauth-client-credentials-flow",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "tooltip": "Send client ID and client secret as a Basic Auth header, or as client credentials in the request body",
                "binding": {
                    "name": "authentication.clientAuthentication",
                    "type": "property"
                },
                "id": "authentication.clientAuthentication",
                "label": "Client authentication",
                "type": "Dropdown",
                "choices": [
                    {
                        "name": "Send client credentials in body",
                        "value": "credentialsBody"
                    },
                    {
                        "name": "Send as Basic Auth header",
                        "value": "basicAuthHeader"
                    }
                ],
                "constraints": {"notEmpty": true},
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "oauth-client-credentials-flow",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "tooltip": "The scopes which you want to request authorization for",
                "binding": {
                    "name": "authentication.scopes",
                    "type": "property"
                },
                "id": "authentication.scopes",
                "label": "Scopes",
                "placeholder": "read:contacts",
                "type": "String",
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "oauth-refresh-token",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "binding": {
                    "name": "authentication.oauthRefreshToken.oauthTokenEndpoint",
                    "type": "property"
                },
                "id": "authentication.oauthRefreshToken.oauthTokenEndpoint",
                "label": "OAuth 2.0 token endpoint",
                "type": "String",
                "constraints": {
                    "pattern": {
                        "message": "Must be a http(s) URL",
                        "value": "^(=|(http://|https://|secrets|\\{\\{).*$)"
                    },
                    "notEmpty": true
                },
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "oauth-refresh-token",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "tooltip": "Your application's client ID from the OAuth client",
                "binding": {
                    "name": "authentication.oauthRefreshToken.clientId",
                    "type": "property"
                },
                "id": "authentication.oauthRefreshToken.clientId",
                "label": "Client ID",
                "type": "String",
                "constraints": {"notEmpty": true},
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "oauth-refresh-token",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "tooltip": "Your application's client secret from the OAuth client",
                "binding": {
                    "name": "authentication.oauthRefreshToken.clientSecret",
                    "type": "property"
                },
                "id": "authentication.oauthRefreshToken.clientSecret",
                "label": "Client secret",
                "secret": true,
                "type": "String",
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "oauth-refresh-token",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "tooltip": "The refresh token used to obtain a new access token",
                "binding": {
                    "name": "authentication.oauthRefreshToken.refreshToken",
                    "type": "property"
                },
                "id": "authentication.oauthRefreshToken.refreshToken",
                "label": "Refresh token",
                "secret": true,
                "type": "String",
                "constraints": {"notEmpty": true},
                "group": "authentication"
            },
            {
                "condition": {
                    "equals": "oauth-refresh-token",
                    "property": "authentication.type",
                    "type": "simple"
                },
                "tooltip": "The scopes to request authorization for (space-separated)",
                "binding": {
                    "name": "authentication.oauthRefreshToken.scopes",
                    "type": "property"
                },
                "id": "authentication.oauthRefreshToken.scopes",
                "label": "Scopes",
                "type": "String",
                "group": "authentication"
            }
        ]
    }],
