{
    "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
    "keywords": [
        "HTTP",
        "REST",
        "API call",
        "web request",
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "fetch data",
        "send request",
        "invoke API"
    ],
    "icon": {"contents": "data:image/svg+xml;base64,"},
    "description": "Invoke REST API",
    "appliesTo": ["bpmn:Task"],
    "groups": [
        {
            "id": "authentication",
            "label": "Authentication"
        },
        {
            "id": "endpoint",
            "label": "HTTP endpoint"
        },
        {
            "id": "timeout",
            "label": "Connection timeout"
        },
        {
            "id": "payload",
            "label": "Payload"
        },
        {
            "id": "connector",
            "label": "Connector"
        },
        {
            "id": "output",
            "label": "Output mapping"
        },
        {
            "id": "error",
            "label": "Error handling"
        },
        {
            "id": "retries",
            "label": "Retries"
        }
    ],
    "documentationRef": "https://docs.camunda.io/docs/components/connectors/protocol/rest/",
    "version": 14,
    "engines": {"camunda": "^8.10"},
    "name": "REST Outbound Connector",
    "id": "io.camunda.connectors.HttpJson.v2",
    "category": {
        "name": "Connectors",
        "id": "connectors"
    },
    "elementType": {"value": "bpmn:ServiceTask"},
    "properties": [
        {
            "binding": {
                "property": "type",
                "type": "zeebe:taskDefinition"
            },
            "type": "Hidden",
            "value": "io.camunda:http-json:1"
        },
        {
            "description": "Choose the authentication type. Select 'None' if no authentication is necessary",
            "binding": {
                "name": "authentication.type",
                "type": "zeebe:input"
            },
            "id": "authentication.type",
            "label": "Type",
            "type": "Dropdown",
            "choices": [
                {
                    "name": "API key",
                    "value": "apiKey"
                },
                {
                    "name": "Basic",
                    "value": "basic"
                },
                {
                    "name": "Bearer token",
                    "value": "bearer"
                },
                {
                    "name": "None",
                    "value": "noAuth"
                },
                {
                    "name": "OAuth 2.0",
                    "value": "oauth-client-credentials-flow"
                },
                {
                    "name": "OAuth 2.0 Refresh Token",
                    "value": "oauth-refresh-token"
                }
            ],
            "value": "noAuth",
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "apiKey",
                "property": "authentication.type",
                "type": "simple"
            },
            "description": "Choose type: Send API key in header or as query parameter.",
            "binding": {
                "name": "authentication.apiKeyLocation",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "authentication.apiKeyLocation",
            "label": "Api key location",
            "type": "Dropdown",
            "choices": [
                {
                    "name": "Headers",
                    "value": "headers"
                },
                {
                    "name": "Query parameters",
                    "value": "query"
                }
            ],
            "value": "headers",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "apiKey",
                "property": "authentication.type",
                "type": "simple"
            },
            "feel": "optional",
            "binding": {
                "name": "authentication.name",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "authentication.name",
            "label": "API key name",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "apiKey",
                "property": "authentication.type",
                "type": "simple"
            },
            "feel": "optional",
            "binding": {
                "name": "authentication.value",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "authentication.value",
            "label": "API key value",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "basic",
                "property": "authentication.type",
                "type": "simple"
            },
            "feel": "optional",
            "binding": {
                "name": "authentication.username",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "authentication.username",
            "label": "Username",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "basic",
                "property": "authentication.type",
                "type": "simple"
            },
            "feel": "optional",
            "binding": {
                "name": "authentication.password",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "authentication.password",
            "label": "Password",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "bearer",
                "property": "authentication.type",
                "type": "simple"
            },
            "feel": "optional",
            "binding": {
                "name": "authentication.token",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "authentication.token",
            "label": "Bearer token",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-client-credentials-flow",
                "property": "authentication.type",
                "type": "simple"
            },
            "description": "The OAuth token endpoint",
            "feel": "optional",
            "binding": {
                "name": "authentication.oauthTokenEndpoint",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "authentication.oauthTokenEndpoint",
            "label": "OAuth 2.0 token endpoint",
            "type": "String",
            "constraints": {
                "pattern": {
                    "message": "Must be a http(s) URL",
                    "value": "^(=|(http://|https://|secrets|\\{\\{).*$)"
                },
                "notEmpty": true
            },
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-client-credentials-flow",
                "property": "authentication.type",
                "type": "simple"
            },
            "description": "Your application's client ID from the OAuth client",
            "feel": "optional",
            "binding": {
                "name": "authentication.clientId",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "authentication.clientId",
            "label": "Client ID",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-client-credentials-flow",
                "property": "authentication.type",
                "type": "simple"
            },
            "description": "Your application's client secret from the OAuth client",
            "feel": "optional",
            "binding": {
                "name": "authentication.clientSecret",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "authentication.clientSecret",
            "label": "Client secret",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-client-credentials-flow",
                "property": "authentication.type",
                "type": "simple"
            },
            "description": "The unique identifier of the target API you want to access",
            "feel": "optional",
            "binding": {
                "name": "authentication.audience",
                "type": "zeebe:input"
            },
            "optional": true,
            "id": "authentication.audience",
            "label": "Audience",
            "type": "String",
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-client-credentials-flow",
                "property": "authentication.type",
                "type": "simple"
            },
            "description": "Send client ID and client secret as Basic Auth request in the header, or as client credentials in the request body",
            "binding": {
                "name": "authentication.clientAuthentication",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "authentication.clientAuthentication",
            "label": "Client authentication",
            "type": "Dropdown",
            "choices": [
                {
                    "name": "Send client credentials in body",
                    "value": "credentialsBody"
                },
                {
                    "name": "Send as Basic Auth header",
                    "value": "basicAuthHeader"
                }
            ],
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-client-credentials-flow",
                "property": "authentication.type",
                "type": "simple"
            },
            "description": "The scopes which you want to request authorization for (e.g.read:contacts)",
            "feel": "optional",
            "binding": {
                "name": "authentication.scopes",
                "type": "zeebe:input"
            },
            "optional": true,
            "id": "authentication.scopes",
            "label": "Scopes",
            "type": "String",
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-refresh-token",
                "property": "authentication.type",
                "type": "simple"
            },
            "description": "The OAuth token endpoint",
            "feel": "optional",
            "binding": {
                "name": "authentication.oauthTokenEndpoint",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "authentication.oauthRefreshToken.oauthTokenEndpoint",
            "label": "OAuth 2.0 token endpoint",
            "type": "String",
            "constraints": {
                "pattern": {
                    "message": "Must be a http(s) URL",
                    "value": "^(=|(http://|https://|secrets|\\{\\{).*$)"
                },
                "notEmpty": true
            },
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-refresh-token",
                "property": "authentication.type",
                "type": "simple"
            },
            "description": "Your application's client ID from the OAuth client",
            "feel": "optional",
            "binding": {
                "name": "authentication.clientId",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "authentication.oauthRefreshToken.clientId",
            "label": "Client ID",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-refresh-token",
                "property": "authentication.type",
                "type": "simple"
            },
            "description": "Your application's client secret from the OAuth client",
            "feel": "optional",
            "binding": {
                "name": "authentication.clientSecret",
                "type": "zeebe:input"
            },
            "optional": true,
            "id": "authentication.oauthRefreshToken.clientSecret",
            "label": "Client secret",
            "type": "String",
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-refresh-token",
                "property": "authentication.type",
                "type": "simple"
            },
            "description": "The refresh token used to obtain a new access token",
            "feel": "optional",
            "binding": {
                "name": "authentication.refreshToken",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "authentication.oauthRefreshToken.refreshToken",
            "label": "Refresh token",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-refresh-token",
                "property": "authentication.type",
                "type": "simple"
            },
            "description": "The scopes to request authorization for (space-separated)",
            "feel": "optional",
            "binding": {
                "name": "authentication.scopes",
                "type": "zeebe:input"
            },
            "optional": true,
            "id": "authentication.oauthRefreshToken.scopes",
            "label": "Scopes",
            "type": "String",
            "group": "authentication"
        },
        {
            "binding": {
                "name": "method",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "method",
            "label": "Method",
            "type": "Dropdown",
            "choices": [
                {
                    "name": "POST",
                    "value": "POST"
                },
                {
                    "name": "GET",
                    "value": "GET"
                },
                {
                    "name": "DELETE",
                    "value": "DELETE"
                },
                {
                    "name": "PATCH",
                    "value": "PATCH"
                },
                {
                    "name": "PUT",
                    "value": "PUT"
                }
            ],
            "value": "GET",
            "constraints": {"notEmpty": true},
            "group": "endpoint"
        },
        {
            "feel": "optional",
            "binding": {
                "name": "url",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "url",
            "label": "URL",
            "type": "String",
            "constraints": {
                "pattern": {
                    "message": "Must be a http(s) URL",
                    "value": "^(=|(http://|https://|secrets|\\{\\{).*$)"
                },
                "notEmpty": true
            },
            "group": "endpoint"
        },
        {
            "description": "Map of HTTP headers to add to the request",
            "feel": "required",
            "binding": {
                "name": "headers",
                "type": "zeebe:input"
            },
            "optional": true,
            "id": "headers",
            "label": "Headers",
            "type": "String",
            "group": "endpoint"
        },
        {
            "description": "Map of query parameters to add to the request URL",
            "feel": "required",
            "binding": {
                "name": "queryParameters",
                "type": "zeebe:input"
            },
            "optional": true,
            "id": "queryParameters",
            "label": "Query parameters",
            "type": "String",
            "group": "endpoint"
        },
        {
            "description": "Store the response as a document in the document store",
            "feel": "static",
            "binding": {
                "name": "storeResponse",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "storeResponse",
            "label": "Store response",
            "type": "Boolean",
            "value": false,
            "group": "endpoint"
        },
        {
            "description": "Skip the default URL decoding and encoding behavior",
            "binding": {
                "name": "skipEncoding",
                "type": "zeebe:input"
            },
            "optional": true,
            "id": "skipEncoding",
            "label": "Skip URL encoding",
            "type": "Hidden",
            "group": "endpoint"
        },
        {
            "description": "If enabled, HTTP 3xx redirects will be followed automatically. Disabled by default.",
            "feel": "static",
            "binding": {
                "name": "followRedirects",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "followRedirects",
            "label": "Follow redirects",
            "type": "Boolean",
            "value": false,
            "group": "endpoint"
        },
        {
            "description": "Defines the connection timeout in seconds, or 0 for an infinite timeout",
            "feel": "static",
            "binding": {
                "name": "connectionTimeoutInSeconds",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "connectionTimeoutInSeconds",
            "label": "Connection timeout in seconds",
            "type": "Number",
            "value": 20,
            "constraints": {
                "pattern": {
                    "message": "Must be a number",
                    "value": "^\\d+$"
                },
                "notEmpty": true
            },
            "group": "timeout"
        },
        {
            "description": "Timeout in seconds to read data from an established connection or 0 for an infinite timeout",
            "feel": "static",
            "binding": {
                "name": "readTimeoutInSeconds",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "readTimeoutInSeconds",
            "label": "Read timeout in seconds",
            "type": "Number",
            "value": 20,
            "constraints": {
                "pattern": {
                    "message": "Must be a number",
                    "value": "^\\d+$"
                },
                "notEmpty": true
            },
            "group": "timeout"
        },
        {
            "condition": {
                "oneOf": [
                    "POST",
                    "PUT",
                    "PATCH"
                ],
                "property": "method",
                "type": "simple"
            },
            "description": "Payload to send with the request",
            "feel": "optional",
            "binding": {
                "name": "body",
                "type": "zeebe:input"
            },
            "optional": true,
            "id": "body",
            "label": "Request body",
            "type": "Text",
            "group": "payload"
        },
        {
            "condition": {
                "oneOf": [
                    "POST",
                    "PUT",
                    "PATCH"
                ],
                "property": "method",
                "type": "simple"
            },
            "tooltip": "Null values will not be sent",
            "feel": "static",
            "binding": {
                "name": "ignoreNullValues",
                "type": "zeebe:input"
            },
            "optional": false,
            "id": "ignoreNullValues",
            "label": "Ignore null values",
            "type": "Boolean",
            "value": false,
            "group": "payload"
        },
        {
            "description": "Version of the element template",
            "binding": {
                "type": "zeebe:taskHeader",
                "key": "elementTemplateVersion"
            },
            "id": "version",
            "label": "Version",
            "type": "Hidden",
            "value": "14",
            "group": "connector"
        },
        {
            "description": "ID of the element template",
            "binding": {
                "type": "zeebe:taskHeader",
                "key": "elementTemplateId"
            },
            "id": "id",
            "label": "ID",
            "type": "Hidden",
            "value": "io.camunda.connectors.HttpJson.v2",
            "group": "connector"
        },
        {
            "description": "Name of variable to store the response in. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-variable\" target=\"_blank\">documentation<\/a>.",
            "binding": {
                "type": "zeebe:taskHeader",
                "key": "resultVariable"
            },
            "id": "resultVariable",
            "label": "Result variable",
            "type": "String",
            "group": "output"
        },
        {
            "description": "Expression to map the response into process variables. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-expression\" target=\"_blank\">documentation<\/a>.",
            "feel": "required",
            "binding": {
                "type": "zeebe:taskHeader",
                "key": "resultExpression"
            },
            "id": "resultExpression",
            "label": "Result expression",
            "type": "Text",
            "value": "{\n  myResponseBody: response.body\n  // Use FEEL to extract values, e.g.,:\n  // myUserId: response.body.post.userId\n}",
            "group": "output"
        },
        {
            "description": "Expression to handle errors. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/\" target=\"_blank\">documentation<\/a>.",
            "feel": "required",
            "binding": {
                "type": "zeebe:taskHeader",
                "key": "errorExpression"
            },
            "id": "errorExpression",
            "label": "Error expression",
            "type": "Text",
            "group": "error"
        },
        {
            "description": "Number of retries",
            "feel": "optional",
            "binding": {
                "property": "retries",
                "type": "zeebe:taskDefinition"
            },
            "id": "retryCount",
            "label": "Retries",
            "type": "String",
            "value": "3",
            "group": "retries"
        },
        {
            "description": "ISO-8601 duration to wait between retries",
            "binding": {
                "type": "zeebe:taskHeader",
                "key": "retryBackoff"
            },
            "id": "retryBackoff",
            "label": "Retry backoff",
            "type": "String",
            "value": "PT0S",
            "group": "retries"
        }
    ]
}
