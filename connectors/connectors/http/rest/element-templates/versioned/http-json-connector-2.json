{
    "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
    "icon": {"contents": "data:image/svg+xml;utf8,%3Csvg%20width%3D%2218%22%20height%3D%2218%22%20viewBox%3D%220%200%2018%2018%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%0A%3Cpath%20d%3D%22M17.0335%208.99997C17.0335%2013.4475%2013.4281%2017.0529%208.98065%2017.0529C4.53316%2017.0529%200.927765%2013.4475%200.927765%208.99997C0.927765%204.55248%204.53316%200.947083%208.98065%200.947083C13.4281%200.947083%2017.0335%204.55248%2017.0335%208.99997Z%22%20fill%3D%22%23505562%22%2F%3E%0A%3Cpath%20d%3D%22M4.93126%2014.1571L6.78106%203.71471H10.1375C11.1917%203.71471%2011.9824%203.98323%2012.5095%204.52027C13.0465%205.04736%2013.315%205.73358%2013.315%206.57892C13.315%207.44414%2013.0714%208.15522%2012.5841%208.71215C12.1067%209.25913%2011.4553%209.63705%2010.6298%209.8459L12.0619%2014.1571H10.3315L9.03364%2010.0249H7.24351L6.51254%2014.1571H4.93126ZM7.49711%208.59281H9.24248C9.99832%208.59281%2010.5901%208.42374%2011.0177%208.08561C11.4553%207.73753%2011.6741%207.26513%2011.6741%206.66842C11.6741%206.19106%2011.5249%205.81811%2011.2265%205.54959C10.9282%205.27113%2010.4558%205.1319%209.80936%205.1319H8.10874L7.49711%208.59281Z%22%20fill%3D%22white%22%2F%3E%0A%3C%2Fsvg%3E%0A"},
    "description": "Invoke REST API",
    "appliesTo": ["bpmn:Task"],
    "groups": [
        {
            "id": "authentication",
            "label": "Authentication"
        },
        {
            "id": "endpoint",
            "label": "HTTP endpoint"
        },
        {
            "id": "input",
            "label": "Payload"
        },
        {
            "id": "timeout",
            "label": "Connect timeout"
        },
        {
            "id": "output",
            "label": "Response mapping"
        },
        {
            "id": "errors",
            "label": "Error handling"
        }
    ],
    "version": 2,
    "documentationRef": "https://docs.camunda.io/docs/components/connectors/out-of-the-box-connectors/rest/",
    "engines": {"camunda": "^8.2"},
    "name": "REST connector",
    "id": "io.camunda.connectors.HttpJson.v2",
    "category": {
        "name": "Connectors",
        "id": "connectors"
    },
    "elementType": {"value": "bpmn:ServiceTask"},
    "properties": [
        {
            "binding": {
                "property": "type",
                "type": "zeebe:taskDefinition"
            },
            "type": "Hidden",
            "value": "io.camunda:http-json:1"
        },
        {
            "description": "Choose the authentication type. Select 'None' if no authentication is necessary",
            "binding": {
                "name": "authentication.type",
                "type": "zeebe:input"
            },
            "label": "Type",
            "id": "authenticationType",
            "type": "Dropdown",
            "choices": [
                {
                    "name": "None",
                    "value": "noAuth"
                },
                {
                    "name": "Basic",
                    "value": "basic"
                },
                {
                    "name": "Bearer token",
                    "value": "bearer"
                },
                {
                    "name": "OAuth 2.0",
                    "value": "oauth-client-credentials-flow"
                }
            ],
            "value": "noAuth",
            "group": "authentication"
        },
        {
            "binding": {
                "name": "method",
                "type": "zeebe:input"
            },
            "id": "method",
            "label": "Method",
            "type": "Dropdown",
            "choices": [
                {
                    "name": "GET",
                    "value": "get"
                },
                {
                    "name": "POST",
                    "value": "post"
                },
                {
                    "name": "PATCH",
                    "value": "patch"
                },
                {
                    "name": "PUT",
                    "value": "put"
                },
                {
                    "name": "DELETE",
                    "value": "delete"
                }
            ],
            "value": "get",
            "group": "endpoint"
        },
        {
            "feel": "optional",
            "binding": {
                "name": "url",
                "type": "zeebe:input"
            },
            "label": "URL",
            "type": "String",
            "constraints": {
                "pattern": {
                    "message": "Must be a http(s) URL",
                    "value": "^(=|(https?://|secrets\\..+|\\{\\{secrets\\..+\\}\\}).*$)"
                },
                "notEmpty": true
            },
            "group": "endpoint"
        },
        {
            "description": "Map of query parameters to add to the request URL",
            "feel": "required",
            "binding": {
                "name": "queryParameters",
                "type": "zeebe:input"
            },
            "optional": true,
            "label": "Query parameters",
            "type": "Text",
            "group": "endpoint"
        },
        {
            "description": "Map of HTTP headers to add to the request",
            "feel": "required",
            "binding": {
                "name": "headers",
                "type": "zeebe:input"
            },
            "optional": true,
            "label": "HTTP headers",
            "type": "Text",
            "group": "endpoint"
        },
        {
            "condition": {
                "equals": "bearer",
                "property": "authenticationType"
            },
            "feel": "optional",
            "binding": {
                "name": "authentication.token",
                "type": "zeebe:input"
            },
            "label": "Bearer token",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-client-credentials-flow",
                "property": "authenticationType"
            },
            "description": "The OAuth token endpoint",
            "feel": "optional",
            "binding": {
                "name": "authentication.oauthTokenEndpoint",
                "type": "zeebe:input"
            },
            "label": "OAuth token endpoint",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-client-credentials-flow",
                "property": "authenticationType"
            },
            "description": "Your application's client ID from the OAuth client",
            "feel": "optional",
            "binding": {
                "name": "authentication.clientId",
                "type": "zeebe:input"
            },
            "label": "Client ID",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-client-credentials-flow",
                "property": "authenticationType"
            },
            "description": "Your application's client secret from the OAuth client",
            "feel": "optional",
            "binding": {
                "name": "authentication.clientSecret",
                "type": "zeebe:input"
            },
            "label": "Client secret",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-client-credentials-flow",
                "property": "authenticationType"
            },
            "description": "The scopes which you want to request authorization for (e.g.read:contacts)",
            "feel": "optional",
            "binding": {
                "name": "authentication.scopes",
                "type": "zeebe:input"
            },
            "optional": true,
            "label": "Scopes",
            "type": "String",
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-client-credentials-flow",
                "property": "authenticationType"
            },
            "description": "The unique identifier of the target API you want to access",
            "feel": "optional",
            "binding": {
                "name": "authentication.audience",
                "type": "zeebe:input"
            },
            "optional": true,
            "label": "Audience",
            "type": "String",
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "oauth-client-credentials-flow",
                "property": "authenticationType"
            },
            "description": "Send client ID and client secret as Basic Auth request in the header, or as client credentials in the request body",
            "binding": {
                "name": "authentication.clientAuthentication",
                "type": "zeebe:input"
            },
            "label": "Client authentication",
            "id": "authentication.clientAuthentication",
            "type": "Dropdown",
            "choices": [
                {
                    "name": "Send client credentials in body",
                    "value": "credentialsBody"
                },
                {
                    "name": "Send as Basic Auth header",
                    "value": "basicAuthHeader"
                }
            ],
            "value": "basicAuthHeader",
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "basic",
                "property": "authenticationType"
            },
            "feel": "optional",
            "binding": {
                "name": "authentication.username",
                "type": "zeebe:input"
            },
            "label": "Username",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "condition": {
                "equals": "basic",
                "property": "authenticationType"
            },
            "feel": "optional",
            "binding": {
                "name": "authentication.password",
                "type": "zeebe:input"
            },
            "label": "Password",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "description": "Sets the timeout in seconds to establish a connection or 0 for an infinite timeout",
            "binding": {
                "name": "connectionTimeoutInSeconds",
                "type": "zeebe:input"
            },
            "feel": "optional",
            "optional": true,
            "label": "Connection timeout",
            "type": "String",
            "value": "20",
            "constraints": {
                "pattern": {
                    "message": "Must be a timeout in seconds (default value is 20 seconds) or a FEEL expression",
                    "value": "^(=|([0-9]+|secrets\\..+|\\{\\{secrets\\..+\\}\\})$)"
                },
                "notEmpty": false
            },
            "group": "timeout"
        },
        {
            "condition": {
                "oneOf": [
                    "post",
                    "put",
                    "patch",
                    "delete"
                ],
                "property": "method"
            },
            "description": "Payload to send with the request",
            "feel": "optional",
            "binding": {
                "name": "body",
                "type": "zeebe:input"
            },
            "optional": true,
            "label": "Request body",
            "type": "Text",
            "group": "input"
        },
        {
            "description": "Name of variable to store the response in. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-variable\" target=\"_blank\">documentation<\/a>",
            "binding": {
                "type": "zeebe:taskHeader",
                "key": "resultVariable"
            },
            "label": "Result variable",
            "type": "String",
            "group": "output"
        },
        {
            "description": "Expression to map the response into process variables. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-expression\" target=\"_blank\">documentation<\/a>",
            "feel": "required",
            "binding": {
                "type": "zeebe:taskHeader",
                "key": "resultExpression"
            },
            "label": "Result expression",
            "type": "Text",
            "group": "output"
        },
        {
            "description": "Expression to handle errors. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#bpmn-errors\" target=\"_blank\">documentation<\/a>",
            "feel": "required",
            "binding": {
                "type": "zeebe:taskHeader",
                "key": "errorExpression"
            },
            "label": "Error expression",
            "type": "Text",
            "group": "errors"
        }
    ]
}
