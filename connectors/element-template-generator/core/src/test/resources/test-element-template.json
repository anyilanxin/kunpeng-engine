{
    "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
    "keywords": [
        "foo",
        "bar"
    ],
    "name": "Template: Some Function",
    "description": "Describe this connector",
    "appliesTo": ["bpmn:Task"],
    "groups": [
        {
            "id": "authentication",
            "label": "Authentication"
        },
        {
            "id": "compose",
            "label": "Compose"
        },
        {
            "tooltip": "Map the response to process variables",
            "id": "output",
            "label": "Output Mapping"
        },
        {
            "id": "errors",
            "label": "Error Handling"
        }
    ],
    "id": "io.camunda.connector.Template.v1",
    "category": {
        "name": "Connectors",
        "id": "connectors"
    },
    "documentationRef": "https://docs.camunda.io/docs/components/connectors/out-of-the-box-connectors/available-connectors-overview/",
    "version": 1,
    "elementType": {"value": "bpmn:ServiceTask"},
    "properties": [
        {
            "binding": {
                "property": "type",
                "type": "zeebe:taskDefinition"
            },
            "type": "Hidden",
            "value": "io.camunda:template:1"
        },
        {
            "description": "The username for authentication.",
            "feel": "optional",
            "binding": {
                "name": "authentication.user",
                "type": "zeebe:input"
            },
            "label": "Username",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "description": "The token for authentication.",
            "feel": "static",
            "binding": {
                "name": "authentication.token",
                "type": "zeebe:input"
            },
            "label": "Token",
            "type": "String",
            "constraints": {"notEmpty": true},
            "group": "authentication"
        },
        {
            "description": "The type of message to compose",
            "binding": {
                "name": "compose.type",
                "type": "zeebe:input"
            },
            "label": "Type",
            "type": "Dropdown",
            "choices": [{
                "name": "message",
                "value": "Compose a message"
            }],
            "group": "compose"
        },
        {
            "binding": {
                "name": "compose.withTopic",
                "type": "zeebe:input"
            },
            "label": "With topic?",
            "type": "Dropdown",
            "choices": [
                {
                    "name": "With topic",
                    "value": "withTopic"
                },
                {
                    "name": "Without topic",
                    "value": "withoutTopic"
                }
            ],
            "group": "compose"
        },
        {
            "condition": {"allMatch": [
                {
                    "equals": "message",
                    "property": "compose.type",
                    "type": "simple"
                },
                {
                    "equals": "withTopic",
                    "property": "compose.withTopic",
                    "type": "simple"
                }
            ]},
            "description": "The topic of the message",
            "feel": "optional",
            "binding": {
                "name": "compose.topic",
                "type": "zeebe:input"
            },
            "label": "Topic",
            "type": "Text",
            "group": "compose"
        },
        {
            "condition": {
                "equals": "message",
                "property": "compose.type",
                "type": "simple"
            },
            "feel": "optional",
            "binding": {
                "name": "message",
                "type": "zeebe:input"
            },
            "label": "Message",
            "type": "Text",
            "constraints": {"notEmpty": true},
            "group": "compose"
        },
        {
            "description": "Name of variable to store the response in",
            "feel": "optional",
            "binding": {
                "type": "zeebe:taskHeader",
                "key": "resultVariable"
            },
            "label": "Result Variable",
            "type": "String",
            "group": "output"
        },
        {
            "description": "Expression to map the response into process variables",
            "feel": "required",
            "binding": {
                "type": "zeebe:taskHeader",
                "key": "resultExpression"
            },
            "label": "Result Expression",
            "type": "Text",
            "group": "output"
        },
        {
            "description": "Expression to handle errors. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/\" target=\"_blank\">documentation<\/a>.",
            "feel": "required",
            "binding": {
                "type": "zeebe:taskHeader",
                "key": "errorExpression"
            },
            "label": "Error Expression",
            "type": "Text",
            "group": "errors"
        }
    ]
}
