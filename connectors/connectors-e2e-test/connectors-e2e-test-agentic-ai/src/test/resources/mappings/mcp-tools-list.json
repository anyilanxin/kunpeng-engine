{
    "request": {
        "method": "POST",
        "bodyPatterns": [{"matchesJsonPath": {
            "expression": "$.method",
            "equalTo": "tools/list"
        }}],
        "url": "/mcp"
    },
    "response": {
        "headers": {"Content-Type": "application/json"},
        "transformers": ["response-template"],
        "jsonBody": {
            "result": {"tools": [
                {
                    "inputSchema": {
                        "type": "object",
                        "properties": {
                            "paramA1": {
                                "description": "The first parameter",
                                "type": "string"
                            },
                            "paramA2": {
                                "description": "The second parameter",
                                "type": "number"
                            }
                        }
                    },
                    "name": "toolA",
                    "description": "The first tool",
                    "title": "Tool A"
                },
                {
                    "inputSchema": {
                        "type": "object",
                        "properties": {
                            "paramB1": {
                                "description": "The first parameter",
                                "type": "string"
                            },
                            "paramB2": {
                                "type": "string",
                                "enum": [
                                    "A",
                                    "B",
                                    "C"
                                ]
                            }
                        }
                    },
                    "name": "toolB",
                    "description": "The second tool",
                    "title": "Tool B"
                },
                {
                    "inputSchema": {
                        "type": "object",
                        "properties": {"paramC1": {
                            "description": "The first parameter",
                            "type": "string"
                        }}
                    },
                    "name": "toolC",
                    "description": "The third tool",
                    "title": "Tool C"
                }
            ]},
            "id": "{{jsonPath request.body '$.id'}}",
            "jsonrpc": "2.0"
        },
        "status": 200
    }
}
