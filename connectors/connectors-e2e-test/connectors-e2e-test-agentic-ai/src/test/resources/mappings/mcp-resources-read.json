{"mappings": [
    {
        "request": {
            "method": "POST",
            "bodyPatterns": [
                {"matchesJsonPath": {
                    "expression": "$.method",
                    "equalTo": "resources/read"
                }},
                {"matchesJsonPath": {
                    "expression": "$.params.uri",
                    "equalTo": "resourceA"
                }}
            ],
            "url": "/mcp"
        },
        "response": {
            "headers": {"Content-Type": "application/json"},
            "transformers": ["response-template"],
            "jsonBody": {
                "result": {"contents": [{
                    "mimeType": "text/plain",
                    "text": "This is the content of Resource A.",
                    "uri": "resourceA"
                }]},
                "id": "{{jsonPath request.body '$.id'}}",
                "jsonrpc": "2.0"
            },
            "status": 200
        }
    },
    {
        "request": {
            "method": "POST",
            "bodyPatterns": [
                {"matchesJsonPath": {
                    "expression": "$.method",
                    "equalTo": "resources/read"
                }},
                {"matchesJsonPath": {
                    "expression": "$.params.uri",
                    "equalTo": "resourceC"
                }}
            ],
            "url": "/mcp"
        },
        "response": {
            "headers": {"Content-Type": "application/json"},
            "transformers": ["response-template"],
            "jsonBody": {
                "result": {"contents": [{
                    "mimeType": "text/markdown",
                    "text": "# This is the content of Resource C.",
                    "uri": "resourceC"
                }]},
                "id": "{{jsonPath request.body '$.id'}}",
                "jsonrpc": "2.0"
            },
            "status": 200
        }
    },
    {
        "request": {
            "method": "POST",
            "bodyPatterns": [
                {"matchesJsonPath": {
                    "expression": "$.method",
                    "equalTo": "resources/read"
                }},
                {"matchesJsonPath": {
                    "expression": "$.params.uri",
                    "equalTo": "resource-a-1"
                }}
            ],
            "url": "/mcp"
        },
        "response": {
            "headers": {"Content-Type": "application/json"},
            "transformers": ["response-template"],
            "jsonBody": {
                "result": {"contents": [{
                    "mimeType": "text/plain",
                    "text": "This is the content of Resource A number 1.",
                    "uri": "resource-a-1"
                }]},
                "id": "{{jsonPath request.body '$.id'}}",
                "jsonrpc": "2.0"
            },
            "status": 200
        }
    }
]}
