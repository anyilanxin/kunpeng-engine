{
    "request": {
        "method": "POST",
        "bodyPatterns": [{"matchesJsonPath": {
            "expression": "$.method",
            "equalTo": "prompts/list"
        }}],
        "url": "/mcp"
    },
    "response": {
        "headers": {"Content-Type": "application/json"},
        "transformers": ["response-template"],
        "jsonBody": {
            "result": {
                "nextCursor": null,
                "prompts": [
                    {
                        "name": "promptA",
                        "description": "This is prompt A",
                        "arguments": [{
                            "name": "aName",
                            "description": "A name",
                            "required": true
                        }],
                        "title": "Prompt A"
                    },
                    {
                        "name": "promptB",
                        "description": "This is prompt B",
                        "arguments": [{
                            "name": "bName",
                            "description": "B name",
                            "required": true
                        }],
                        "title": "Prompt B"
                    },
                    {
                        "name": "promptC",
                        "description": "This is prompt C",
                        "arguments": [{
                            "name": "aName",
                            "description": "C name",
                            "required": true
                        }],
                        "title": "Prompt C"
                    }
                ]
            },
            "id": "{{jsonPath request.body '$.id'}}",
            "jsonrpc": "2.0"
        },
        "status": 200
    }
}
