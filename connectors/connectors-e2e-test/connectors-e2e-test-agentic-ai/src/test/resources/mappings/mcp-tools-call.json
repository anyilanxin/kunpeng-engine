{"mappings": [
    {
        "request": {
            "method": "POST",
            "bodyPatterns": [
                {"matchesJsonPath": {
                    "expression": "$.method",
                    "equalTo": "tools/call"
                }},
                {"matchesJsonPath": {
                    "expression": "$.params.name",
                    "equalTo": "toolA"
                }}
            ],
            "url": "/mcp"
        },
        "response": {
            "headers": {"Content-Type": "application/json"},
            "transformers": ["response-template"],
            "jsonBody": {
                "result": {
                    "isError": false,
                    "content": [{
                        "text": "A MCP Client result",
                        "type": "text"
                    }]
                },
                "id": "{{jsonPath request.body '$.id'}}",
                "jsonrpc": "2.0"
            },
            "status": 200
        }
    },
    {
        "request": {
            "method": "POST",
            "bodyPatterns": [
                {"matchesJsonPath": {
                    "expression": "$.method",
                    "equalTo": "tools/call"
                }},
                {"matchesJsonPath": {
                    "expression": "$.params.name",
                    "equalTo": "toolC"
                }}
            ],
            "url": "/mcp"
        },
        "response": {
            "headers": {"Content-Type": "application/json"},
            "transformers": ["response-template"],
            "jsonBody": {
                "result": {
                    "isError": false,
                    "content": [{
                        "text": "A Remote MCP Client result",
                        "type": "text"
                    }]
                },
                "id": "{{jsonPath request.body '$.id'}}",
                "jsonrpc": "2.0"
            },
            "status": 200
        }
    }
]}
