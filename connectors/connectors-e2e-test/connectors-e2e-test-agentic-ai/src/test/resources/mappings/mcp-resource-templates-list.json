{
    "request": {
        "method": "POST",
        "bodyPatterns": [{"matchesJsonPath": {
            "expression": "$.method",
            "equalTo": "resources/templates/list"
        }}],
        "url": "/mcp"
    },
    "response": {
        "headers": {"Content-Type": "application/json"},
        "transformers": ["response-template"],
        "jsonBody": {
            "result": {"resourceTemplates": [
                {
                    "uriTemplate": "resource-a-{number}",
                    "name": "Resource A {number}",
                    "description": "The first resource",
                    "mimeType": "text/plain",
                    "title": "A resource"
                },
                {
                    "uriTemplate": "resource-b-{number}",
                    "name": "Resource B {number}",
                    "description": "The second resource",
                    "mimeType": "text/plain",
                    "title": "B resource"
                },
                {
                    "uriTemplate": "resource-c-{number}",
                    "name": "Resource C {number}",
                    "description": "The third resource",
                    "mimeType": "text/markdown",
                    "title": "C resource"
                }
            ]},
            "id": "{{jsonPath request.body '$.id'}}",
            "jsonrpc": "2.0"
        },
        "status": 200
    }
}
