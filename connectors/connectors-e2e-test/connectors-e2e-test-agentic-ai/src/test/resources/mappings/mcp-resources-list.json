{
    "request": {
        "method": "POST",
        "bodyPatterns": [{"matchesJsonPath": {
            "expression": "$.method",
            "equalTo": "resources/list"
        }}],
        "url": "/mcp"
    },
    "response": {
        "headers": {"Content-Type": "application/json"},
        "transformers": ["response-template"],
        "jsonBody": {
            "result": {"resources": [
                {
                    "name": "Resource A",
                    "description": "The first resource",
                    "mimeType": "text/plain",
                    "title": "A resource",
                    "uri": "resourceA"
                },
                {
                    "name": "Resource B",
                    "description": "The second resource",
                    "mimeType": "text/plain",
                    "title": "B resource",
                    "uri": "resourceB"
                },
                {
                    "name": "Resource C",
                    "description": "The third resource",
                    "mimeType": "text/markdown",
                    "title": "C resource",
                    "uri": "resourceC"
                }
            ]},
            "id": "{{jsonPath request.body '$.id'}}",
            "jsonrpc": "2.0"
        },
        "status": 200
    }
}
