{"mappings": [
    {
        "request": {
            "method": "POST",
            "bodyPatterns": [{"matchesJsonPath": {
                "expression": "$.method",
                "equalTo": "initialize"
            }}],
            "url": "/mcp"
        },
        "response": {
            "headers": {"Content-Type": "application/json"},
            "transformers": ["response-template"],
            "jsonBody": {
                "result": {
                    "capabilities": {
                        "logging": {},
                        "resources": {
                            "listChanged": false,
                            "subscribe": false
                        },
                        "tools": {"listChanged": false},
                        "prompts": {"listChanged": false}
                    },
                    "protocolVersion": "2025-06-18"
                },
                "id": "{{jsonPath request.body '$.id'}}",
                "jsonrpc": "2.0"
            },
            "status": 200
        }
    },
    {
        "request": {
            "headers": {"Accept": {"equalTo": "text/event-stream"}},
            "method": "GET",
            "url": "/mcp"
        },
        "response": {"status": 200}
    }
]}
